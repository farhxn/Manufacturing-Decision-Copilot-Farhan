# Manufacturing Decision Copilot - Backend Environment Variables

# ─────────────────────────────────────────────
# AI Provider Configuration (Default: Free Gemini + Local Embeddings)
# ─────────────────────────────────────────────
AI_PROVIDER=gemini
EMBEDDING_PROVIDER=local

# Google Gemini API Key (Get a free key at https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy_your_free_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash

# Optional: Local Embeddings (100% Free, runs inside ChromaDB locally)
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional: OpenAI API Key (if switching to OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional: Groq API Key (if switching to Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mdc_db

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─────────────────────────────────────────────
# ChromaDB
# ─────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_data

# ─────────────────────────────────────────────
# Storage
# ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ─────────────────────────────────────────────
# API
# ─────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
